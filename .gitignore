# Python tooling and Blender backup files; retain .py and editable .blend sources.
__pycache__/
*.py[cod]
.venv/
venv/
*.blend[0-9]
*.blend[0-9][0-9]

# OS-generated files.
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local credentials and environment overrides. Keep documented templates.
.env
.env.*
!.env.example
!.env.template
*.p12
*.pfx
*.keystore
*.jks

# Pipeline's transient build assets and local server descriptors/tokens.
**/Assets/Settings/Pipeline/Resources/RuntimePipelineConfig.asset*
**/Assets/Settings/Pipeline/Resources/RuntimePipelineBuildInfo.asset*
**/.unity-pipeline-port
**/.unity-pipeline-runtime-port
