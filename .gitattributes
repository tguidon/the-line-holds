* text=auto
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.meta text eol=lf

# Unity writes a space after empty YAML values; keep its serialized output intact.
*.meta whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol

# Keep imported TextMeshPro package resources unchanged by formatting cleanups.
"TheLineHolds/Assets/TextMesh Pro/**" -whitespace

*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Preserve downloaded license notices as supplied by their authors.
Tools/Audio/Sources/Kenney/License.txt -whitespace
Tools/Audio/Sources/Gunshots/creativecommons.txt -whitespace
*.ttf filter=lfs diff=lfs merge=lfs -text
